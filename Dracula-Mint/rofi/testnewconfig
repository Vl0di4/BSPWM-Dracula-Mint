configuration {
    modi: "drun,window";
    lines: 5;
    font: "JetBrains Mono 12";
    show-icons: true;
    icon-theme: "Papirus-dark";
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-window: "   Window ";
    sidebar-mode: true;
}

@theme "catppuccin"

window {
    height: 360px;
    width: 700px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    padding: 10px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [active-window, prompt, entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 5px;
    spacing: 10px;
}

active-window {
    str: "Active: {window_title}";
    text-color: @grey;
    padding: 6px;
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    text-color: @fg-col;
    background-color: @bg-col;
    placeholder: "Search...";
}

listview {
    border: 0px 0px 0px;
    padding: 6px;
    columns: 1;
    spacing: 10px;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 4px;
}

element-icon {
    size: 25px;
    margin: 0 10px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col2;
}

mode-switcher {
    spacing: 10px;
    children: [button];
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    border-radius: 4px;
}

button selected {
    background-color: @blue;
    text-color: @bg-col;
}
