configuration {
    modi: "drun,window";
    lines: 10; /* Увеличено количество строк для единого списка */
    font: "JetBrains Mono 12";
    show-icons: true;
    icon-theme: "Papirus-dark";
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-window: "   Window ";
    sidebar-mode: false; /* Отключен sidebar для кастомной раскладки */
}

@theme "catppuccin"

/* Главное окно */
window {
    height: 600px; /* Увеличена высота окна */
    width: 800px; /* Широкое окно для разделения контента */
    border: 1px;
    border-color: @border-col;
    background-color: @bg-col;
}

/* Основной контейнер */
mainbox {
    background-color: @bg-col;
    children: [listbox, mode-switcher]; /* Список и переключатель */
    layout: horizontal; /* Горизонтальное распределение */
    spacing: 10px; /* Пробел между колонками */
}

/* Левый блок: поиск и переключатели */
inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 10px;
    spacing: 10px;
    layout: vertical; /* Расположено по вертикали */
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
    margin: 10px;
}

entry {
    padding: 6px;
    margin: 5px;
    text-color: @fg-col;
    background-color: @bg-col;
    placeholder: "Search";
}

/* Переключатель "Apps" и "Windows" */
mode-switcher {
    spacing: 5px;
    layout: horizontal; /* Горизонтальное расположение */
    horizontal-align: start;
    padding: 10px;
    background-color: @bg-col-light;
}

button {
    padding: 5px;
    background-color: @bg-col-light;
    text-color: @grey;
    border-radius: 3px;
    margin: 5px;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}

/* Правый блок: список приложений */
listview {
    border: 0px 0px 0px;
    padding: 10px;
    margin: 10px;
    columns: 1; /* Один столбец */
    layout: vertical; /* Вертикальное расположение */
    background-color: @bg-col;
}

element {
    padding: 5px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element-icon {
    size: 25px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col2;
}
